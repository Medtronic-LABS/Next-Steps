{
  "indexes": [
    {
      "//": "Worklist by level — steps at a facility's own level, open first, by due date.",
      "collectionGroup": "steps",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "level", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "due", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Worklist by owner role — steps a user owns across facilities.",
      "collectionGroup": "steps",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "ownerRole", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "due", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Open alerts per facility.",
      "collectionGroup": "alerts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "facilityId", "order": "ASCENDING" },
        { "fieldPath": "resolvedAt", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
