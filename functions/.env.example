# Copy to functions/.env for local dev against a real WhatsApp test number.
# Never commit functions/.env — it's gitignored.
#
# For a real deploy, these are NOT read from here — they're bound via Secret
# Manager (see src/config/secrets.ts) using:
#   firebase functions:secrets:set WHATSAPP_PHONE_NUMBER_ID
#   firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN
#   firebase functions:secrets:set META_APP_SECRET
#   firebase functions:secrets:set WHATSAPP_VERIFY_TOKEN
#   firebase functions:secrets:set RESET_DEMO_TOKEN

# From Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# From Meta App Dashboard -> App Settings -> Basic -> App Secret
META_APP_SECRET=

# Any string you choose yourself; must match what you enter in Meta's
# webhook configuration (Callback verify token)
WHATSAPP_VERIFY_TOKEN=

# Set to "true" to force the in-memory MockWhatsAppClient even outside the
# Functions emulator (e.g. local `node` scripts). Ignored under
# FUNCTIONS_EMULATOR=true, which always uses the mock regardless.
WHATSAPP_MOCK=false

# Published WhatsApp Flow ids (see docs/whatsapp/flows.md). Each is
# independently optional — unset falls back to the equivalent
# buttons/list/text screen; the app works fully either way.
FLOW_CLOSURE_PROVENANCE_ID=
FLOW_SELECT_ITEM_ID=
FLOW_MENU_ID=

# Any string you choose yourself — required header (x-reset-token) or
# ?token= query value to call the admin/resetDemo.ts HTTPS endpoint.
# Not a WhatsApp/Meta credential.
RESET_DEMO_TOKEN=

# Real CCE (Care Coordination Engine) integration — both unset by default.
# adapter/CCEClient.ts falls back to an in-memory mock until both are set
# AND bound into cceOutboxConsumer's secrets (see docs/whatsapp/flows.md-
# style note in CCEClient.ts for why these aren't defineSecret-bound yet).
CCE_ENDPOINT_URL=
CCE_API_KEY=
