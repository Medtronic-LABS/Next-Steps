{
  "version": "7.2",
  "screens": [
    {
      "id": "SELECT",
      "title": "Select",
      "terminal": true,
      "success": true,
      "data": {
        "kind": { "type": "string", "__example__": "patient" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "LAKSHMI_DEVI", "title": "Lakshmi Devi", "description": "Referred — due 20 Sep" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "Dropdown",
                "name": "selected",
                "label": "Select one",
                "required": true,
                "data-source": "${data.items}"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "kind": "${data.kind}",
                    "selected_id": "${form.selected}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
